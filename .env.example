# Cadena de conexion de tu proyecto Supabase (Settings > Database > Connection string > URI)
# Usa el puerto 5432 (conexion directa) para desarrollo/demo.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Supabase exige SSL. Dejar en true salvo que uses un Postgres local sin SSL.
PGSSL=true

# Delay simulado por cada micro-paso de la Saga (observabilidad), en milisegundos.
STEP_DELAY_MIN_MS=2000
STEP_DELAY_MAX_MS=4000
